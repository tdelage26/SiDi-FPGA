<misterromdescription>
	<name>Performan</name>
	<setname>perfrmanu</setname>
	<parent>Performan</parent>
	<year>1986</year>
	<manufacturer>Toaplan</manufacturer>
	<category>Puzzle</category>
	<rbf>SlapFight</rbf>
	<!-- MiST: ARC needs MOD=3 (pcb variant). ROM image uses the SlapFight.sv download layout. -->
	<rotation>vertical (ccw)</rotation>
	<joystick>8-way</joystick>
	<buttons default="A,B,Start,Select" names="Dive,Boomerang,-,-,-,-,Start,Coin,P2 Start,-"></buttons>
	<switches default="FF,FF,FF">
		<dip bits="14" name="Dip Switch Test" ids="ON,OFF"/>
		<dip bits="13" name="Test Screen" ids="ON,OFF"/>
		<dip bits="12" name="Cabinet" ids="Upright,Table"/>
		<dip bits="11" name="Attract" ids="Demo Sound Off,Demo Sound On"/>
		<dip bits="8,10" name="Coinage" ids="Free Play,3 Coins 1 Play,3 Coins 1 Play,2 Coins 3 Play,2 Coins 1 Play,1 Coin 3 Plays,1 Coin 2 Plays,1 Coin 1 Play"/>
		<dip bits="22,23" name="Loop Excent" ids="300000,200000,100000,Nothing"/>
		<dip bits="20,21" name="Extend" ids="Nothing,60000,40000,20000"/>
		<dip bits="18,19" name="Game Level" ids="3,2,1,0"/>
		<dip bits="16,17" name="Hero Count" ids="2,1,5,3"/>
	</switches>
	<rom index="0" md5="none" zip="perfrman.zip" type="merged|nonmerged">
		<!-- 0x00000 main CPU -->
		<part crc="7ad32eea" name="ci07.0"/>
		<part crc="9d373efa" name="ci108r5.1"/>
		<!-- 0x08000 ep1 slot (unused on Performan) -->
		<part repeat="0x8000"> 00 </part>
		<!-- 0x10000 audio CPU -->
		<part crc="df891ad0" name="ci06.4"/>
		<!-- 0x12000-0x17FFF FG ep3/ep4/dummy (no FG on Performan) -->
		<part repeat="0x6000"> 00 </part>
		<!-- 0x18000 BG ep5/ep6/ep7 (8KB each in a 32KB slot), ep8 slot empty -->
		<part crc="79e191f8" name="ci00.5"/>
		<part repeat="0x6000"> 00 </part>
		<part crc="2e8e69df" name="ci01.6"/>
		<part repeat="0x6000"> 00 </part>
		<part crc="8efa960a" name="ci02.7"/>
		<part repeat="0x6000"> 00 </part>
		<part repeat="0x8000"> 00 </part>
		<!-- 0x38000 sprites ep9/ep10/ep11, ep12 slot empty -->
		<part crc="6410d9eb" name="ci03.8"/>
		<part repeat="0x6000"> 00 </part>
		<part crc="026f27b3" name="ci04.9"/>
		<part repeat="0x6000"> 00 </part>
		<part crc="809a4ccc" name="ci05.10"/>
		<part repeat="0x6000"> 00 </part>
		<part repeat="0x8000"> 00 </part>
		<!-- 0x58000 colour PROMs (cp1=R cp2=B cp3=G) -->
		<part crc="515f8a3b" name="ci14.16"/>
		<part crc="67f86e3d" name="ci12.14"/>
		<part crc="a9a397eb" name="ci13.15"/>
		<!-- 0x58300 sprite reg PROM 1, 0x58400 reg PROM 2, 0x58500 sequencer PROM (32 bytes) -->
		<part crc="59490887" name="ci10.12"/>
		<part crc="D492E6C2" name="ci11.11"/>
		<part crc="D9E92F6F" name="ci09r1.13"/>
	</rom>
	<rom index="1">
		<part>3</part>
	</rom>	
</misterromdescription>
